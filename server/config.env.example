ELASTICSEARCH_URL=http://localhost:9200
PORT=3001
NODE_ENV=development

# LLM Configuration (optional - for AI-powered summaries)
# Choose provider: 'groq' (recommended for public apps - free tier), 'openai', or 'huggingface'
LLM_PROVIDER=groq

# Groq API (Recommended - Fast, free tier, great for public apps)
# Get free API key from: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.1-8b-instant

# OpenAI API (Alternative)
# Get your API key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=your-api-key-here
# OPENAI_MODEL=gpt-4o-mini

# Hugging Face API (Alternative - Free tier available)
# Get API key from: https://huggingface.co/settings/tokens
# HUGGINGFACE_API_KEY=your-hf-api-key-here
# HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.2

# Rate Limiting (optional - defaults shown)
# LLM_RATE_LIMIT_MINUTE=30
# LLM_RATE_LIMIT_HOUR=500
# LLM_RATE_LIMIT_DAY=10000

